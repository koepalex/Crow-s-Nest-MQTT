<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CrowsNestMqtt.App</RootNamespace>
    <AssemblyName>CrowsNestMqtt.App</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>$(TargetRuntimeIdentifiers)</RuntimeIdentifiers>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    
    <!-- Global Tool Properties -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>crowsnest-mqtt</ToolCommandName>
    <PackageId>CrowsNestMqtt.App</PackageId>
    <Version>0.1.0</Version>
    <Authors>Alexander Köpke</Authors>
    <Description>A cross-platform MQTT client and visualizer for browsing MQTT topic hierarchies and message payloads</Description>
    <PackageTags>mqtt;client;visualization;avalonia;cross-platform</PackageTags>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="All" />
    <PackageReference Include="HotAvalonia" PrivateAssets="All" Publish="True" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
    <PackageReference Include="GitVersion.MsBuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SharpHook" />
    <PackageReference Include="SharpHook.Reactive" />
  </ItemGroup>

  <ItemGroup>
   <ProjectReference Include="../UI/UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- Explicitly remove the moved App files to avoid potential conflicts -->
  <ItemGroup>
    <Compile Remove="App.axaml.cs" />
    <AvaloniaXaml Remove="App.axaml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <LinuxLibVlcDirectory>/usr/lib/x86_64-linux-gnu</LinuxLibVlcDirectory>
      <LinuxLibVlcPluginsDirectory>$(LinuxLibVlcDirectory)/vlc/plugins</LinuxLibVlcPluginsDirectory>
    </PropertyGroup>

    <Target Name="CopyLinuxLibVlc" AfterTargets="Build;Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <Error Condition="!Exists('$(LinuxLibVlcDirectory)/libvlc.so.5')" Text="LibVLC is required for Linux builds. Install the libvlc5 package." />
      <ItemGroup>
        <LinuxLibVlcLibraries Include="$(LinuxLibVlcDirectory)/libvlc.so.*;$(LinuxLibVlcDirectory)/libvlccore.so.*" />
        <LinuxLibVlcPlugins Include="$(LinuxLibVlcPluginsDirectory)/**/*" />
      </ItemGroup>
        <Error Condition="'@(LinuxLibVlcPlugins)' == ''" Text="VLC plugin modules are required for Linux builds. Install the vlc-plugin-base package." />
      <Copy SourceFiles="@(LinuxLibVlcLibraries)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(LinuxLibVlcDirectory)/libvlc.so.5;$(LinuxLibVlcDirectory)/libvlccore.so.9" DestinationFiles="$(TargetDir)libvlc.so;$(TargetDir)libvlccore.so" SkipUnchangedFiles="true" />
      <Copy SourceFiles="@(LinuxLibVlcPlugins)" DestinationFiles="@(LinuxLibVlcPlugins->'$(TargetDir)plugins/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
      <MakeDir Directories="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
      <Copy SourceFiles="@(LinuxLibVlcLibraries)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
        <Copy SourceFiles="$(LinuxLibVlcDirectory)/libvlc.so.5;$(LinuxLibVlcDirectory)/libvlccore.so.9" DestinationFiles="$(PublishDir)libvlc.so;$(PublishDir)libvlccore.so" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
      <Copy SourceFiles="@(LinuxLibVlcPlugins)" DestinationFiles="@(LinuxLibVlcPlugins->'$(PublishDir)plugins/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
    </Target>
</Project>
