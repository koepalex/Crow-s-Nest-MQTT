<Window
    x:Class="CrowsNestMqtt.UI.Views.StatsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentAvalonia.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CrowsNestMqtt.UI.ViewModels"
    Title="Topic Statistics"
    Width="820"
    Height="520"
    MinWidth="500"
    MinHeight="300"
    d:DesignHeight="500"
    d:DesignWidth="800"
    x:CompileBindings="False"
    x:DataType="vm:StatsViewModel"
    CanResize="True"
    Icon="avares://CrowsNestMqtt.App/Assets/icon.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.KeyBindings>
        <KeyBinding Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Gesture="Escape" />
        <KeyBinding Command="{Binding RefreshCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding CopyAsMarkdownCommand}" Gesture="Ctrl+C" />
    </Window.KeyBindings>

    <Window.Styles>
        <!--  DataGrid headers blend into the surrounding card background  -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!--  Header bottom border (separator between column headers and rows)  -->
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Fill" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto">

        <!--  Statistics Card  -->
        <Border
            Grid.Row="0"
            Margin="8,8,8,0"
            Classes="Card">
            <Grid RowDefinitions="Auto,*">
                <Border
                    Grid.Row="0"
                    Padding="8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            LineHeight="20"
                            Text="Topic Statistics" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Per-topic statistics (lifetime totals, updated every second)" />
                    </StackPanel>
                </Border>

                <DataGrid
                    x:Name="StatsGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Rows}"
                    SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Topic}"
                            Header="Topic" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding MessageCount}"
                            Header="# Messages" />
                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding TotalPayloadDisplay}"
                            Header="Total Size"
                            SortMemberPath="TotalPayloadBytes" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding AveragePayloadDisplay}"
                            Header="Avg Size"
                            SortMemberPath="AveragePayloadBytes" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding MeanIntervalDisplay}"
                            Header="Mean Interval"
                            SortMemberPath="MeanIntervalSortKey" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!--  Action buttons  -->
        <StackPanel
            Grid.Row="1"
            Margin="8"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh now (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:FASymbolIcon FontSize="16" Symbol="Refresh" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button
                Classes="accent"
                Command="{Binding CopyAsMarkdownCommand}"
                ToolTip.Tip="Copy as Markdown (Ctrl+C)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Width="14"
                        Height="14"
                        Data="{StaticResource copy_regular}" />
                    <TextBlock FontWeight="SemiBold" Text="Copy as Markdown" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Status Bar  -->
        <Border
            Grid.Row="2"
            Height="32"
            Padding="16,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusText}"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
